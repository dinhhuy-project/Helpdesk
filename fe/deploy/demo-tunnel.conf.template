# Only used by docker-compose.demo.yml behind cloudflared. This is NOT a public HTTP listener.
map $http_upgrade $helpdesk_connection { default upgrade; '' close; }
map "$status:$uri" $helpdesk_cache {
    default "no-store";
    ~^200:/assets/ "public, max-age=31536000, immutable";
}
log_format helpdesk '$remote_addr $request_method $uri $status $request_time';
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    # Only the fixed cloudflared container may supply Cloudflare's client-IP header.
    set_real_ip_from 172.29.240.4;
    real_ip_header CF-Connecting-IP;
    access_log /dev/stdout helpdesk;
    error_log /dev/null;
    add_header Cache-Control $helpdesk_cache always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    client_max_body_size 12m;
    # Cloudflare terminates public TLS; redirect any public HTTP request before login.
    if ($http_x_forwarded_proto = http) { return 308 https://$host$request_uri; }
    location ~ ^/(api|hubs|health)(/|$) {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $helpdesk_connection;
        proxy_hide_header Cache-Control;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
    }
    location ^~ /assets/ { try_files $uri =404; }
    location ~ /\. { return 404; }
    location / { try_files $uri $uri/ /index.html; }
}
