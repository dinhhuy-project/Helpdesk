# Local development only. Copy to .env and fill in credentials before starting.
COMPOSE_PROJECT_NAME=helpdesk
API_PORT=5000
# Required when running the API service through Compose. Use a long random key (at least 32 bytes).
# Visual Studio Container (Dockerfile) uses project user-secrets instead.
JWT_ISSUER=Helpdesk.Api
JWT_AUDIENCE=Helpdesk.Web
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
# Absolute refresh-session lifetime in days (1-30); rotation does not extend it.
JWT_REFRESH_TOKEN_DAYS=7
POSTGRES_PORT=5432
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=
REDIS_PORT=6379
REDIS_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=helpdesk-admin
# Minimum 8 characters; use a long random value.
MINIO_ROOT_PASSWORD=
# Run be/scripts/Initialize-ComposeStorage.ps1 to generate the app credentials and initialize MinIO.
# Keep .env after Docker cleanup: minio startup recreates the bucket/user/policy from these keys.
# Normal startup: docker compose up -d --build --wait postgres redis minio
# Apply the reviewed database migration separately before starting the backend.
MINIO_ENABLED=false
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=

# Optional independent BookStack stack: .\be\scripts\Initialize-KnowledgeWiki.ps1
# Uses docker-compose.wiki.yml, its own MariaDB and persistent volumes.
BOOKSTACK_PORT=6875
BOOKSTACK_APP_URL=http://localhost:6875
BOOKSTACK_APP_KEY=
BOOKSTACK_DB_PASSWORD=
BOOKSTACK_DB_ROOT_PASSWORD=
# Compose API connector settings (Visual Studio uses backend user-secrets instead).
KNOWLEDGE_WIKIPEDIA_ENABLED=true
BOOKSTACK_CONNECTOR_ENABLED=false
BOOKSTACK_SOURCE_ID=support-wiki
BOOKSTACK_BASE_URL=http://host.docker.internal:6875/
BOOKSTACK_BOOK_ID=0
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=
